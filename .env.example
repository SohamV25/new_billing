# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Create the database first:
#   createdb billing
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billing?schema=public"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the application (used for redirects and emails).
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# API base URL used by the browser. Same origin in production.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
